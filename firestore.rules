rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        request.auth.token.email == 'kaliabhavyam123@gmail.com'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Resources collection (Notes & Lectures)
    match /resources/{resourceId} {
      // Any student can browse and read resources
      allow read: if true;
      // Only verified admins can upload, edit, or delete syllabus resources
      allow create, update, delete: if isAdmin();
    }

    // 3. Ratings collection
    match /ratings/{ratingId} {
      allow read: if true;
      // Only authenticated students can rate, 1 rating per user
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Bookmarks collection
    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Activity / Progress collection
    match /activity/{activityId} {
      allow read, write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
