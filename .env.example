# StudySphere - Environment Variables Configuration
# ==================================================

# Server Port
PORT=8080

# Secret Key for HMAC-SHA256 Session Signing
SESSION_SECRET=studysphere-hackathon-secure-salt-2026

# OpenAI API Key for Study AI Assistant
# Note: Keep blank to use the built-in intelligent academic fallback engine,
# or provide your OpenAI key (e.g. sk-proj-...) for live GPT completions.
OPENAI_API_KEY=
